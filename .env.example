# Docker Compose host ports
HOST_GATEWAY_PORT=8081
HOST_POSTGRES_PORT=5433
HOST_REDIS_PORT=6379
HOST_MOCK_PORT=18080

# Gateway container -> PostgreSQL / Redis
GATEWAY_PG_HOST=postgres
GATEWAY_PG_PORT=5432
GATEWAY_PG_DATABASE=llm_gateway
GATEWAY_PG_USERNAME=llm_user
GATEWAY_PG_PASSWORD=llm_password
GATEWAY_REDIS_HOST=redis
GATEWAY_REDIS_PORT=6379
GATEWAY_REDIS_PASSWORD=

# Gateway runtime
GATEWAY_SHARED_STATE_BACKEND=redis
GATEWAY_PROVIDERS_OPENAI_BASE_URL=http://mock:18080
GATEWAY_SYNC_MODELS_DEV_ENABLED=false
UPSTREAM_OPENAI_KEY=upstream-demo-key
SPRING_FLYWAY_ENABLED=true

# Default local credentials
GATEWAY_AUTH_JWT_SECRET=dev-secret-key-at-least-32-chars-long
GATEWAY_ADMIN_PASSWORD=admin123
GATEWAY_USER_PASSWORD=user123
